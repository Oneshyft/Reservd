# Database
DATABASE_URL="file:./dev.db"

# Reddit (no credentials needed — uses public JSON API)
# REDDIT_USER_AGENT=SuiteSpotter/1.0

# How far back to look for Reddit posts (in days, default 180)
DAYS_LOOKBACK=180

# Twitter/X (Optional - enables live keyword monitoring)
TWITTER_BEARER_TOKEN=

# Email Notifications (Optional - for digests and alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

# Target Configuration
SUITE_CITY=Detroit
TARGET_NFL_TEAM=Detroit Lions
TARGET_NHL_TEAM=Detroit Red Wings
TARGET_NFL_VENUE=Ford Field
TARGET_NHL_VENUE=Little Caesars Arena
